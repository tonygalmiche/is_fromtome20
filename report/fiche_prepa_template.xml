<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_picking_inherit" inherit_id="stock.report_picking">
            <!-- v20 : t-lang refusé hors d'un t-call (« t-lang is an alias of t-options-lang ») ; sans effet sur ce
                 t-foreach en v14 déjà : rapport dans la langue de l'utilisateur, désignation française par
                 is_description_prepa -->
            <!-- v20 : le rapport n'appelle plus web.external_layout (ni en-tête, ni pied de page) : page remise dans la
                 mise en page de la société comme en v14 ; classe article retirée du div englobant (sinon page en double) -->
            <xpath expr="//div[hasclass('article')]" position="attributes">
                <attribute name="class">o_report_layout_standard</attribute>
            </xpath>
            <xpath expr="//div[hasclass('page')]" position="replace">
                <t t-call="web.external_layout">$0</t>
            </xpath>
            <!-- Absents en v14 : type d'opération en titre, entrepôt -->
            <h3 t-field="o.picking_type_id.code" position="replace"/>
            <div name="div_warehouse" position="replace"/>
            <div name="right_box" position="replace"/>
            <!-- v20 : titre en h2, date prévue dans div_picking_date, tableau principal o_main_table -->
            <h2 t-field="o.name" position="replace"/>
            <div name="div_picking_date" position="replace">
                <div name="div_picking_date">
                    <strong>Date de livraison prévue:</strong>
                    <p t-field="o.is_date_livraison"/>
                </div>
                <div>
                    <strong>Transporteur:</strong>
                    <p t-field="o.is_transporteur_id"/>
                </div>
            </div>
            <xpath expr="//table[hasclass('o_main_table')]" position="replace">
            <style>
                .table{
                    font-size:10pt;
                }
                .table-sm th, .table-sm td {
                    padding: 0.1rem;
                }
                .table tbody td {
                    background-color: white !important;
                }
                .table tbody tr.ligne_grise td {
                    background-color: #e9ecef !important;
                }
            </style>
               <table class="table table-sm mt48">
                    <thead>
                        <tr>
                            <th class="text-start"> <strong></strong></th>
                            <th class="text-start"> <strong>Désignation</strong></th>
                            <th class="text-start"> <strong>Réf</strong></th>
                            <th class="text-end"> <strong>Colis Cde</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_ids" t-as="line" t-att-class="'ligne_grise' if line_odd else None">
                            <td style="width: 2mm"   class="text-center"><span t-field="line.is_emplacement_fournisseur"/></td>
                            <td style="width: 150mm" class="text-start">
                                <div><strong><span t-field="line.is_description_prepa"/></strong></div>
                            </td>
                            <td style="width: 10mm" class="text-start"><span t-field="line.is_ref_fournisseur"/></td>
                            <td style="width: 10mm" class="text-end"><b><span t-field="line.is_nb_colis_cde"/></b></td>
                        </tr>
                    </tbody>
                    <thead>
                        <tr>
                            <th colspan="3" class="text-start">  <strong>Total : </strong></th>
                            <th class="text-end"><strong><span t-field="o.is_nb_colis"/></strong></th>
                        </tr>
                    </thead>
                </table>
            </xpath>
        </template>

        <!-- Nom français de la v14 (« Opérations de transfert » en v20) ; nom traduisible : valeur française -->
        <record id="stock.action_report_picking" model="ir.actions.report" context="{'lang': 'fr_FR'}">
            <field name="name">Bon de préparation avec code barre</field>
        </record>
    </data>
</odoo>
