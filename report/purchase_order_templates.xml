<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="purchase_stock.report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-if='o.dest_address_id']" position="after">
            <t t-else="">
                <t t-set="information_block">
                    <strong>Adresse de livraison:</strong>
                    <t t-if="o.is_adresse_livraison_id">
                        <div>
                            <span t-field="o.is_adresse_livraison_id.name"/>
                            <div t-field="o.is_adresse_livraison_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </t>
                    <t t-else="">
                        <div t-if="o.picking_type_id and o.picking_type_id.warehouse_id">
                            <span t-field="o.picking_type_id.warehouse_id.name"/>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </t>
                </t>
            </t>
        </xpath>
        <!-- v20 : incoterm dans le rapport standard (ajout v14 retiré : page remplacée ci-dessous de toute façon) -->
    </template>

    <template id="is_report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <!-- v20 : titre standard (layout_document_title) vidé, titre Fromtome en h2 dans la page -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title"/>
        </xpath>
        <!-- PDF en français comme en v14 (langue du fournisseur en v20) -->
        <xpath expr="//t[@t-set='o']" position="attributes">
            <attribute name="t-value">o.with_context(lang='fr_FR')</attribute>
        </xpath>
        <div class="page" position="replace">
            <div class="page">
                <div class="oe_structure"/>
                <h2 t-if="o.is_transporteur and o.state != 'done'">Demande de prix N°<span t-field="o.name"/></h2>
                <h2 t-elif="o.state != 'cancel'">Confirmation du Bon de commande N°<span t-field="o.name"/></h2>
                <h2 t-if="o.state == 'cancel'">Cancelled Purchase Order #<span t-field="o.name"/></h2>
                <div id="informations" class="row mt32 mb32">
                    <div t-if="o.is_date_enlevement" class="col-3 bm-2">
                        <strong>Date d'enlèvement:</strong>
                        <p t-field="o.is_date_enlevement" class="m-0" t-options='{"format": "d MMMM y"}'/>
                    </div>
                   <div t-if="o.date_planned" class="col-3 bm-2" style="background-color:Silver;font-weight: bold;">
                        <strong>Date de livraison:</strong>
                        <p t-field="o.date_planned" class="m-0" t-options='{"format": "d MMMM y"}' style="font-size:14pt"/>
                    </div>
                </div>
                <br />
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start" t-if="company.is_regroupe_cde=='Non'">    <strong>Client</strong></th>
                            <th name="th_description"><strong>Description</strong></th>
                            <th class="text-start"><strong>Réf</strong></th>
                            <th class="text-end" style="background-color:Silver;font-weight: bold;">   <strong>Nb Colis</strong></th>
                            <th class="text-end">   <strong>Quantité</strong></th>
                            <th class="text-start">    <strong>Unité</strong></th>
                            <th class="text-end">   <strong>PU HT</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.order_line" t-as="line">
                            <td class="text-start" t-if="company.is_regroupe_cde=='Non'">
                                <span t-field="line.is_client_id.is_code_interne"/>
                            </td>
                            <td class="text-start">
                                <span t-field="line.name"/>
                            </td>
                           <td class="text-start">
                                <span t-field="line.is_ref_fournisseur"/>
                            </td>
                            <td class="text-end"  style="background-color:Silver;font-weight: bold;">
                                <span t-field="line.is_nb_colis"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.product_qty"/>
                            </td>
                            <td class="text-start">
                                <span t-field="line.uom_id.name"/>
                            </td>
                            <td class="text-end">
                                <span 
                                    t-field="line.price_unit"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                />
                            </td>
                        </tr>

                    </tbody>
                </table>
                
                <!-- Tableau des livraisons pour les transporteurs -->
                <t t-if="o.is_transporteur and o.is_livraison_ids">
                    <br/>
                    <p t-if="o.is_date_enlevement">
                        <strong>Enlèvement chez <span t-field="company.partner_id.name"/></strong>
                        (<span t-field="company.partner_id.street"/> <span t-field="company.partner_id.zip"/> <span t-field="company.partner_id.city"/>)
                        le <span t-field="o.is_date_enlevement" t-options='{"format": "EEEE d MMMM y"}'/>
                    </p>
                    <h3>Livraisons clients associées</h3>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th class="text-start"><strong>N°BL</strong></th>
                                <th class="text-start"><strong>N°Commande client</strong></th>
                                <th class="text-start"><strong>Adresse de livraison</strong></th>
                                <th class="text-end"><strong>Nb colis commandés</strong></th>
                                <th class="text-end"><strong>Poids net commandé</strong></th>
                                <th class="text-end"><strong>Palettes</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.order_line.filtered('is_picking_id')" t-as="line">
                                <t t-set="picking" t-value="line.is_picking_id"/>
                                <td class="text-start">
                                    <span t-field="picking.name"/>
                                </td>
                                <td class="text-start">
                                    <span t-field="picking.sale_id.name"/>
                                </td>
                                <td class="text-start">
                                    <span t-field="picking.partner_id.display_name"/>
                                    <span t-if="picking.partner_id.street">
                                        <br/>
                                        <span t-field="picking.partner_id.street"/>
                                    </span>
                                    <span t-if="picking.partner_id.zip or picking.partner_id.city">
                                        <br/>
                                        <span t-field="picking.partner_id.zip"/> <span t-field="picking.partner_id.city"/>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span t-field="picking.is_nb_colis_cde_total"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="picking.is_poids_net_cde_total"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.product_qty"/>
                                </td>                              
                            </tr>
                        </tbody>
                    </table>
                    
                    <!-- Totaux -->
                    <div class="row">
                        <div class="col-6 offset-6">
                            <table class="table table-sm">
                                <tr>
                                    <td class="text-end"><strong>Total colis:</strong></td>
                                    <td class="text-end">
                                        <span t-field="o.is_total_colis_livraisons"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end"><strong>Total poids (kg):</strong></td>
                                    <td class="text-end">
                                        <span t-field="o.is_total_poids_livraisons"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end"><strong>Total palettes:</strong></td>
                                    <td class="text-end">
                                        <span t-out="sum(o.order_line.filtered('is_picking_id').mapped('product_qty'))"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
                
                <p t-field="o.notes"/>
                <div class="oe_structure"/>
            </div>
        </div>
    </template>

    <!-- PDF en français comme en v14 -->
    <template id="is_report_purchaseorder" inherit_id="purchase.report_purchaseorder">
        <xpath expr="//t[@t-call='purchase.report_purchaseorder_document']" position="attributes">
            <attribute name="t-lang">'fr_FR'</attribute>
        </xpath>
    </template>
</odoo>
