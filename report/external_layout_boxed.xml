<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v20 : agencement « Boxed » de la v14 supprimé ; en-tête et pied de page Fromtome reportés sur « Light »
         (web.external_layout_standard, mis par le script de reprise) : logo et nom de l'enseigne du client, RIB de l'enseigne.
         Classes de l'en-tête dans t-attf-class : contains(), pas hasclass -->
    <template id="is_external_layout_boxed" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, ' header')]/table" position="replace">
            <div class="row mb8" t-if="o and 'partner_id' in o._fields">
                <div class="col-6">
                    <img t-if="o and o.partner_id.is_enseigne_id.name.image_1920" t-att-src="image_data_uri(o.partner_id.is_enseigne_id.name.image_1920)" alt="Logo"/>
                </div>
                <div class="col-6 text-end mb4">
                    <h4 class="mt0" t-field="company.report_header"/>
                    <div name="res_company" class="mb4">
                        <h5 t-if="o and o.partner_id" style="font-weight:700 !important;">
                            <span t-field="o.partner_id.is_enseigne_id.name.name"/>
                            <t t-if="doc_model in ['stock.picking']">
                                - <span t-field="o.name"/>
                            </t>
                            <t t-if="doc_model in ['account.move']">
                                <span> - </span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Facture</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Facture brouillon</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Facture annulée</span>
                                <span t-if="o.move_type == 'out_refund'">Avoir</span>
                                <span t-if="o.move_type == 'in_refund'">Avoir Fournisseur</span>
                                <span t-if="o.move_type == 'in_invoice'">Facture Fournisseur</span>
                                <span t-if="o.name != '/'" t-field="o.name"/>
                            </t>
                        </h5>


                        <span t-field="company.partner_id.street"/>
                        <t t-if="company.partner_id.street2">
                            - <span t-field="company.partner_id.street2"/>
                        </t>
                        <br/>
                        <span t-field="company.partner_id.zip"/> <span t-field="company.partner_id.city"/> -
                        <span t-field="company.country_id"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Pied de page (commun aux agencements en v20) : RIB de l'enseigne du client ; numéro de page déjà dans « Light » -->
    <template id="is_external_layout_footer_content" inherit_id="web.external_layout_footer_content">
        <div t-field="company.report_footer" position="after">
            <t t-if="o and 'partner_id' in o._fields and o.partner_id and o.partner_id.is_enseigne_id and o.partner_id.is_enseigne_id.rib">
                <div t-field="o.partner_id.is_enseigne_id.rib"/>
            </t>
        </div>
    </template>
</odoo>
