<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

        <!-- Bouton « Envoyer par mail » des BL (action_picking_send). v20 : syntaxe ${…} => {{ … }} (en-têtes) et QWeb
             (corps) ; report_template => report_template_ids ; report_name supprimé (nom du PDF : celui du rapport).
             Contenu de la base v14 (modifiée à la main : bon de livraison joint, pas le rapport « Picking » du fichier),
             texte traduit en français (anglais en v14) ; stock.picking.date supprimé en v20 => date du transfert
             (date_done), ou date prévue s'il n'est pas validé -->

        <record id="email_template_stock_picking" model="mail.template">
            <field name="name">Bon de livraison - Envoi par mail</field>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="subject">{{ object.company_id.name }} Bon de livraison (Réf. {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="auto_delete" eval="True"/>
            <field name="report_template_ids" eval="[(4, ref('stock.action_report_delivery'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; ">

    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>

    <p>Veuillez trouver ci-joint votre bon de livraison de <t t-out="object.company_id.name or ''"/> :</p>

    <p style="border-left: 1px solid #8e0000; margin-left: 30px;">
       &#160;&#160;<strong>RÉFÉRENCES</strong><br/>
       &#160;&#160;N° du bon de livraison : <strong t-out="object.name or ''"/><br/>
       &#160;&#160;Date : <t t-out="format_date(object.date_done or object.scheduled_date)"/><br/>
       <t t-if="object.origin">
           &#160;&#160;Votre commande : <t t-out="object.origin"/><br/>
       </t>
       <t t-if="object.user_id">
           &#160;&#160;Votre contact : <a t-attf-href="mailto:{{ object.user_id.email or '' }}?subject=Bon%20de%20livraison%20{{ object.name }}" t-out="object.user_id.name"/>
       </t>
    </p>
    <p>Pour toute question, n'hésitez pas à nous contacter.</p>
    <p>Merci de votre confiance,</p>
    <p><t t-out="object.company_id.name or ''"/></p>
    <br/>
    <br/>
    <div style="width: 375px; margin: 0px; padding: 0px; background-color: #8E0000; border-top-left-radius: 5px 5px; border-top-right-radius: 5px 5px; background-repeat: repeat no-repeat;">
        <h3 style="margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;">
            <strong style="text-transform:uppercase;" t-out="object.company_id.name or ''"/></h3>
    </div>
    <div style="width: 347px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: #F2F2F2;">
        <span style="color: #222; margin-bottom: 5px; display: block; ">
        <t t-if="object.company_id.street">
            <t t-out="object.company_id.street"/><br/>
        </t>
        <t t-if="object.company_id.street2">
            <t t-out="object.company_id.street2"/><br/>
        </t>
        <t t-if="object.company_id.city or object.company_id.zip">
            <t t-out="object.company_id.zip or ''"/> <t t-out="object.company_id.city or ''"/><br/>
        </t>
        <t t-if="object.company_id.country_id">
            <t t-out="object.company_id.state_id and ('%s, ' % object.company_id.state_id.name) or ''"/> <t t-out="object.company_id.country_id.name or ''"/><br/>
        </t>
        </span>
        <div t-if="object.company_id.phone" style="margin: 0px; padding: 0px;">
            Tél. :&#160;<t t-out="object.company_id.phone"/>
        </div>
        <div t-if="object.company_id.website">
            Web :&#160;<a t-att-href="object.company_id.website" t-out="object.company_id.website"/>
        </div>
        <p></p>
    </div>
</div>
            </field>
        </record>

</odoo>
