<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Catégorie et privilèges : un privilège par groupe pour pouvoir cumuler les rôles -->
   <record model="ir.module.category" id="is_groupe_fromtome_module_category">
        <field name="name">Groupes Fromtome</field>
        <field name="description">Groupes Fromtome</field>
        <field name="sequence">10</field>
    </record>

    <record model="res.groups.privilege" id="privilege_gestionnaire_suivi_temps">
        <field name="name">Gestionnaire suivi du temps</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="is_groupe_fromtome_module_category"/>
    </record>
    <record model="res.groups.privilege" id="privilege_gestionnaire_contacts">
        <field name="name">Gestionnaire des contacts</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="is_groupe_fromtome_module_category"/>
    </record>
    <record model="res.groups.privilege" id="privilege_gestionnaire_articles">
        <field name="name">Gestionnaire des articles</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="is_groupe_fromtome_module_category"/>
    </record>
    <record model="res.groups.privilege" id="privilege_analyse_marge_brute">
        <field name="name">Analyse marge brute</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="is_groupe_fromtome_module_category"/>
    </record>
    <record model="res.groups.privilege" id="privilege_afficher_menus_non_utilises">
        <field name="name">Afficher les menus non utilisés</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="is_groupe_fromtome_module_category"/>
    </record>


    <record model="res.groups" id="gestionnaire_suivi_temps_group" >
        <field name="name">Gestionnaire suivi du temps</field>
        <field name="comment"></field>
        <field name="privilege_id" ref="privilege_gestionnaire_suivi_temps"/>
    </record>
    <record model="res.groups" id="is_gestionnaire_contacts_group" >
        <field name="name">Gestionnaire des contacts</field>
        <field name="comment">Ce groupe est le seul pouvant créer, modifier ou supprimer des contacts, clients ou fournisseurs</field>
        <field name="privilege_id" ref="privilege_gestionnaire_contacts"/>
    </record>
    <record model="res.groups" id="is_gestionnaire_articles_group" >
        <field name="name">Gestionnaire des articles</field>
        <field name="comment">Ce groupe est le seul pouvant créer, modifier ou supprimer des articles</field>
        <field name="privilege_id" ref="privilege_gestionnaire_articles"/>
    </record>


    <record model="res.groups" id="is_analyse_marge_brute_group" >
        <field name="name">Analyse marge brute</field>
        <field name="comment">Ce groupe est le seul pouvant accèder aux menus d'analyse de la marge brute</field>
        <field name="privilege_id" ref="privilege_analyse_marge_brute"/>
    </record>

    <!-- Groupe volontairement vide : sert à masquer les menus standard non utilisés (Discussion...), y compris aux administrateurs -->
    <record id="is_afficher_menus_non_utilises_group" model="res.groups">
        <field name="name">Afficher les menus non utilisés</field>
        <field name="privilege_id" ref="privilege_afficher_menus_non_utilises"/>
    </record>



</odoo>
