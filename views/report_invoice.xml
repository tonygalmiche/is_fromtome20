<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v20 : la page de la facture v14 (remplacée en entier) est abandonnée au profit de la facture standard (mentions
         obligatoires françaises de l10n_fr_account dont SIRET, Factur-X, totaux par taxe), complétée ici avec les
         éléments de la v14 : adresses avec GLN et code fournisseur, références de commande et BL, code article, colis,
         PCB et poids par ligne, lots, BIO, remise en texte, total colis et poids, mentions de pénalités -->
    <template id="is_report_invoice_document" inherit_id="account.report_invoice_document">

        <!-- Adresse de livraison toujours affichée (v14), avec son GLN -->
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block">
                <div name="shipping_address_block">
                    <strong class="d-block mt-3">Adresse de livraison</strong>
                    <div><b t-field="o.partner_shipping_id.name"/></div>
                    <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                    <div t-if="o.partner_shipping_id.is_gln">GLN : <span t-field="o.partner_shipping_id.is_gln"/></div>
                </div>
            </t>
        </xpath>

        <!-- Adresse de facturation comme en v14 : libellé, société en gras puis contact sur sa ligne (« Société, contact »
             en v20). Les 3 variantes standard (livraison identique ou non) sont identiques : remplacées par une seule.
             Identifiant du client : n° de TVA seulement (SIRET sinon, en double avec l10n_fr_account) ; SIRET et SIREN
             de l10n_fr_account repris (SIREN : mention obligatoire de la réforme) ; GLN et code fournisseur -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <strong class="d-block">Adresse de facturation</strong>
                <t t-if="o.partner_id.parent_id">
                    <div><b t-field="o.partner_id.parent_id.name"/></div>
                    <div t-field="o.partner_id.name"/>
                </t>
                <div t-else=""><b t-field="o.partner_id.name"/></div>
                <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                <div t-if="o.partner_id.vat" t-out="o._get_document_partner_ident_line()"/>
                <t t-set="partner_siret" t-value="o.partner_id.commercial_partner_id.l10n_fr_siret"/>
                <t t-set="partner_siren" t-value="o.partner_id.commercial_partner_id.l10n_fr_siren"/>
                <div t-if="o.l10n_fr_is_company_french and partner_siret">SIRET : <t t-out="partner_siret"/></div>
                <div t-if="o.l10n_fr_is_company_french and partner_siren">SIREN : <t t-out="partner_siren"/></div>
                <div t-if="o.partner_id.is_gln">GLN : <span t-field="o.partner_id.is_gln"/></div>
                <div t-if="o.partner_id.is_code_fromtome">Code Fournisseur : <span t-field="o.partner_id.is_code_fromtome"/></div>
            </t>
        </xpath>

        <!-- Adresse de la société cliente (l10n_fr_account, facture adressée à un contact) : déjà en haut, absente en v14 -->
        <xpath expr="//div[@name='customer_address']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Taille du texte de la v14 -->
        <xpath expr="//div[@id='informations']" position="before">
            <style>
                .page{
                    font-size:10pt;
                }
            </style>
        </xpath>

        <!-- Informations dans un tableau à bordures comme en v14, colonnes toujours affichées ; la référence (o.ref)
             est le code client. Bloc standard masqué (nature de l'opération de l10n_fr_account : taxes sans portée,
             jamais affichée) -->
        <xpath expr="//div[@id='informations']" position="before">
            <table class="table table-sm table-bordered mb-4" name="is_informations">
                <thead>
                    <tr>
                        <th class="text-center">DATE FACTURE</th>
                        <th class="text-center">ÉCHÉANCE</th>
                        <th class="text-center">CODE CLIENT</th>
                        <th class="text-center">REF CDE CLIENT</th>
                        <th class="text-center">REF CDE INT</th>
                        <th class="text-center">BL</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center"><span t-field="o.invoice_date"/></td>
                        <td class="text-center"><span t-field="o.invoice_date_due"/></td>
                        <td class="text-center"><span t-field="o.ref"/></td>
                        <td class="text-center"><span t-field="o.is_ref_client"/></td>
                        <td class="text-center"><span t-field="o.is_ref_int_cde"/></td>
                        <td class="text-center"><span t-field="o.is_bl"/></td>
                    </tr>
                </tbody>
            </table>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Remise en texte dans la désignation (v14), pas de colonne -->
        <xpath expr="//t[@t-set='display_discount']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Colonnes : code article, colis, PCB, poids (colis et poids absents des avoirs, comme en v14) -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_code" class="text-start"><span>Code produit</span></th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_colis" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><span>Colis</span></th>
            <th name="th_pcb" class="text-center"><span>PCB</span></th>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_poids" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><span>Poids</span></th>
        </xpath>
        <xpath expr="(//t[@t-set='line_colspan'])[1]" position="attributes">
            <attribute name="t-value">3 + (1 if display_discount else 0) + (1 if display_taxes and not line.tax_ids else 0) + (2 if o.move_type in ['in_refund','out_refund'] else 4)</attribute>
        </xpath>
        <!-- Désignation : libellé de la ligne seul, comme en v14 (v20 : nom de l'article ajouté devant quand le libellé
             ne commence pas par lui, ex. « ECHANTILLON : … ») -->
        <xpath expr="//td[@name='account_invoice_line_name']/span[@t-field='line.label']" position="replace">
            <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}" class="d-inline-block w-100 lh-sm"/>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_code" class="text-start"><span t-field="line.product_id.default_code"/></td>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <div t-if="line.is_lots" t-field="line.is_lots"/>
            <div t-if="line.is_bio_id"><i><span t-field="line.is_bio_id.name"/></i></div>
            <div t-if="line.discount">Remise effectuée de <span t-field="line.discount"/>%</div>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_colis" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><b><span t-field="line.is_nb_colis"/></b></td>
            <td name="td_pcb" class="text-center"><span t-field="line.product_id.is_nb_pieces_par_colis"/></td>
        </xpath>
        <xpath expr="//td[@name='td_quantity']" position="after">
            <td name="td_poids" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><span t-field="line.is_poids_net"/></td>
        </xpath>

        <!-- Total colis et poids à gauche des totaux, séparé des lignes par un espace ; condition de paiement en dessous
             (clear:left, sinon le texte se plaçait à côté du bloc flottant). Sans flottant, les totaux passaient sur une
             autre page -->
        <xpath expr="//div[@id='right-elements']" position="before">
            <div t-if="o.move_type not in ['in_refund','out_refund']" name="is_total_colis_poids" class="float-start mt-3">
                <strong>Total colis : </strong><span t-field="o.is_nb_colis"/>
                <br/>
                <strong>Total poids : </strong><span t-field="o.is_poids_net"/>
            </div>
        </xpath>

        <xpath expr="//div[@id='payment_term']" position="attributes">
            <attribute name="style">clear:left</attribute>
        </xpath>

        <!-- Absents en v14 : communication de paiement, QR code -->
        <xpath expr="//p[@name='payment_communication']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-set='show_qr']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Mentions de la v14 -->
        <xpath expr="//div[@id='payment_term']" position="inside">
            <p>
                Sans escompte. Pénalités en cas de retard de paiement : 3 fois le taux d’intérêt légal.<br />
                Indemnité forfaitaire pour frais de recouvrement : 40€ en cas de retard de paiement (Art L441-3 et L441-6 du Code de Commerce).
            </p>
        </xpath>
    </template>

    <!-- Tableau des lots sous les totaux (réglage « Lots sur les factures » actif, sans effet en v14) masqué : lots déjà
         dans la désignation. stock_account est chargé par purchase_stock -->
    <template id="is_stock_account_report_invoice_document" inherit_id="stock_account.stock_account_report_invoice_document">
        <xpath expr="//t[@groups='stock_account.group_lot_on_invoice']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <!-- PDF en français comme en v14 (langue du client en v20 : libellés de la facture standard) -->
    <template id="is_report_invoice" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-set='lang']" position="attributes">
            <attribute name="t-value">'fr_FR'</attribute>
        </xpath>
    </template>

</odoo>
