<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v20 : la page de la facture v14 (remplacée en entier) est abandonnée au profit de la facture standard (mentions
         obligatoires françaises de l10n_fr_account dont SIRET, Factur-X, totaux par taxe), complétée ici avec les
         éléments de la v14 : adresses avec GLN et code fournisseur, références de commande et BL, code article, colis,
         PCB et poids par ligne, lots, BIO, remise en texte, total colis et poids, mentions de pénalités -->
    <template id="is_report_invoice_document" inherit_id="account.report_invoice_document">

        <!-- Adresse de livraison toujours affichée (v14), avec son GLN -->
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block">
                <div name="shipping_address_block">
                    <strong class="d-block mt-3">Adresse de livraison</strong>
                    <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_shipping_id.is_gln">GLN : <span t-field="o.partner_shipping_id.is_gln"/></div>
                </div>
            </t>
        </xpath>

        <!-- Adresse de facturation : GLN et code fournisseur -->
        <xpath expr="//t[@t-set='address']" position="inside">
            <div t-if="o.partner_id.is_gln">GLN : <span t-field="o.partner_id.is_gln"/></div>
            <div t-if="o.partner_id.is_code_fromtome">Code Fournisseur : <span t-field="o.partner_id.is_code_fromtome"/></div>
        </xpath>

        <!-- Taille du texte de la v14 -->
        <xpath expr="//div[@id='informations']" position="before">
            <style>
                .page{
                    font-size:10pt;
                }
            </style>
        </xpath>

        <!-- Informations : origine et code du partenaire masqués (absents en v14) ; la référence (o.ref) est le code
             client ; références de commande client et interne, BL -->
        <xpath expr="//div[@name='origin']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@name='customer_code']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@name='reference']/strong" position="replace">
            <strong>Code client</strong>
        </xpath>
        <xpath expr="//div[@name='reference']" position="after">
            <div class="col" t-if="o.is_ref_client" name="is_ref_client">
                <strong>Réf cde client</strong>
                <div t-field="o.is_ref_client"/>
            </div>
            <div class="col" t-if="o.is_ref_int_cde" name="is_ref_int_cde">
                <strong>Réf cde int</strong>
                <div t-field="o.is_ref_int_cde"/>
            </div>
            <div class="col" t-if="o.is_bl" name="is_bl">
                <strong>BL</strong>
                <div t-field="o.is_bl"/>
            </div>
        </xpath>

        <!-- Remise en texte dans la désignation (v14), pas de colonne -->
        <xpath expr="//t[@t-set='display_discount']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Colonnes : code article, colis, PCB, poids (colis et poids absents des avoirs, comme en v14) -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_code" class="text-start"><span>Code produit</span></th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_colis" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><span>Colis</span></th>
            <th name="th_pcb" class="text-center"><span>PCB</span></th>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_poids" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><span>Poids</span></th>
        </xpath>
        <xpath expr="(//t[@t-set='line_colspan'])[1]" position="attributes">
            <attribute name="t-value">3 + (1 if display_discount else 0) + (1 if display_taxes and not line.tax_ids else 0) + (2 if o.move_type in ['in_refund','out_refund'] else 4)</attribute>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_code" class="text-start"><span t-field="line.product_id.default_code"/></td>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <div t-if="line.is_lots" t-field="line.is_lots"/>
            <div t-if="line.is_bio_id"><i><span t-field="line.is_bio_id.name"/></i></div>
            <div t-if="line.discount">Remise effectuée de <span t-field="line.discount"/>%</div>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_colis" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><b><span t-field="line.is_nb_colis"/></b></td>
            <td name="td_pcb" class="text-center"><span t-field="line.product_id.is_nb_pieces_par_colis"/></td>
        </xpath>
        <xpath expr="//td[@name='td_quantity']" position="after">
            <td name="td_poids" t-if="o.move_type not in ['in_refund','out_refund']" class="text-end"><span t-field="line.is_poids_net"/></td>
        </xpath>

        <!-- Total colis et poids, à gauche des totaux -->
        <xpath expr="//div[@id='right-elements']" position="before">
            <div t-if="o.move_type not in ['in_refund','out_refund']" name="is_total_colis_poids" class="float-start">
                <strong>Total colis : </strong><span t-field="o.is_nb_colis"/>
                <br/>
                <strong>Total poids : </strong><span t-field="o.is_poids_net"/>
            </div>
        </xpath>

        <!-- Absents en v14 : communication de paiement, QR code -->
        <xpath expr="//p[@name='payment_communication']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-set='show_qr']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Mentions de la v14 -->
        <xpath expr="//div[@id='payment_term']" position="inside">
            <p>
                Sans escompte. Pénalités en cas de retard de paiement : 3 fois le taux d’intérêt légal.<br />
                Indemnité forfaitaire pour frais de recouvrement : 40€ en cas de retard de paiement (Art L441-3 et L441-6 du Code de Commerce).
            </p>
        </xpath>
    </template>

</odoo>
