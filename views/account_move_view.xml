<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- account.move -->
    <record id="is_view_move_form" model="ir.ui.view">
        <field name="name">is_view_move_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet[1]" position="inside">
                <style>
                    .o_form_view .o_form_sheet_bg > .o_form_sheet{
                        max-width: 1800px;
                    }
                    .o_form_label{
                        white-space: nowrap;
                    }
                </style>
            </xpath>
            <button name="button_draft" position="after">
                <button 
                        string="Ajout des sous-sections par livraison" 
                        name="ajout_sous_section_action" 
                        type="object"
                />
            </button>
            <field name="partner_id" position="after">
                <field name="is_enseigne_id"/>
            </field>
            <div name="journal_div" position="after">
                <field name="is_motif_avoir_id" invisible="move_type not in ['in_refund','out_refund']"/>
                <field name="is_type_avoir"     invisible="move_type not in ['in_refund','out_refund']"/>
                <field name="is_export_compta_id" readonly="1"/>
                <field name="is_date_relance" invisible="not is_date_relance"/>
                <field name="is_date_releve"  invisible="not is_date_releve"/>
                <field name="is_date_paiement"   invisible="not is_date_paiement"/>
                <field name="is_delai_paiement"  invisible="is_delai_paiement == 0"/>

                <field name="is_date_derniere_commande"/>
                <field name="is_sale_order_id"     invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="is_purchase_order_id" invisible="move_type not in ['in_invoice','in_refund']"/>

            </div>

            <!-- v20 : une seule ligne « échéance ou conditions de paiement » ; comme en v14, les deux sur des lignes séparées -->
            <xpath expr="//label[@for='invoice_date_due']/.." position="replace"/>
            <xpath expr="//div[@name='due_date']" position="replace">
                <field name="invoice_payment_term_id"
                       context="{'example_date': invoice_date, 'example_amount': tax_totals['total_amount_currency']}"
                       options="{'no_quick_create':True}" readonly="state in ['cancel', 'posted']"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
                <field name="invoice_date_due" force_save="1"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"
                       decoration-danger="invoice_date_due and invoice_date_due &lt; context_today().strftime('%Y-%m-%d') and payment_state not in ('paid', 'in_payment', 'reversed')"/>
            </xpath>
            <field name="payment_reference" position="before">
                <field name="is_ref_int_cde"/>
                <field name="is_ref_client"/>
                <field name="is_bl"/>
            </field>
            <xpath expr="//field[@name='invoice_line_ids']/list/column[@name='product_and_description']" position="before">
                <field name="is_picking_id" readonly="1" optional="hide"/>
                <field name="is_bio_id" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="before">
                <field name="is_picking_id" optional="hide"/>
                <field name="is_bio_id" optional="hide"/>
            </xpath>




            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id']" position="after">
                <field name="is_lots"                optional="hide"/>
                <field name="is_nb_pieces_par_colis" optional="hide"/>
                <field name="is_nb_colis" sum="Total"/>
                <button
                    title="Lignes des mouvemments"
                    name="stock_move_line_action"
                    type="object" icon="zoom_in"
                    class="oe_stat_button"
                />
                <field name="is_poids_net"  sum="Total" optional="hide"/>
            </xpath>
            <notebook position="before">
                <div style="background:orange;font-weight: bold;" invisible="not is_alerte">
                    <field
                        name="is_alerte"
                        readonly="1" nolabel="1"
                        invisible="not is_alerte"
                    />
                </div>
            </notebook>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
                <attribute name="limit">1000</attribute>
            </xpath>
            <xpath expr="//page/field[@name='line_ids']/list" position="attributes">
                <attribute name="limit">1000</attribute>
            </xpath>
        </field>
    </record>
    <record id="is_view_invoice_tree" model="ir.ui.view">
        <field name="name">is_view_invoice_tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <!-- v20 : deux colonnes partner_id (fournisseur, client) : après les deux -->
            <field name="journal_id" position="before">
                <field name="is_type_avoir"  optional="show" column_invisible="context.get('default_move_type') not in ('out_refund', 'in_refund')"/>
                <field name="is_enseigne_id" optional="show"/>
            </field>

            <field name="invoice_date" position="before">
                <field name="is_sale_order_id"          optional="hide"/>
                <field name="is_purchase_order_id"      optional="hide"/>
                <field name="is_date_derniere_commande" optional="show"/>
            </field>

            <!-- v20 : plus de colonne state, remplacée par status_in_payment -->
            <field name="status_in_payment" position="before">
                <field name="is_date_paiement"    optional="show"/>
                <field name="is_delai_paiement"   optional="show"/>
                <field name="is_export_compta_id" optional="show"/>
            </field>
            <field name="company_id" position="before">
                <field name="is_date_relance"   optional="hide"/>
                <field name="is_date_releve"    optional="hide"/>
                <field name="date"              optional="hide"/>
                <field name="is_motif_avoir_id" optional="hide"/>
            </field>
        </field>
    </record>




    <record id="is_view_in_invoice_tree" model="ir.ui.view">
        <field name="name">is_view_in_invoice_tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree" />
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="before">
                <field name="invoice_payment_term_id" optional="show"/>
                <field name="invoice_date_due"        optional="show"/>
                <field name="is_motif_avoir_id"       optional="hide"/>
            </field>
        </field>
    </record>
    <record id="is_view_account_invoice_filter" model="ir.ui.view">
        <field name="name">is_view_account_invoice_filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="is_enseigne_id"/>
                <field name="is_motif_avoir_id"/>
                <field name="is_type_avoir"/>
            </field>
        </field>
    </record>


    <!-- account.move.line -->
    <record id="is_account_view_move_line_form" model="ir.ui.view">
        <field name="name">is_account_view_move_line_form</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form" />
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                <field name="price_unit"/>
                <field name="discount"/>
                <field name="price_subtotal"/>
                <field name="is_poids_net" readonly="False"/>
            </field>
        </field>
    </record>


    <!-- account.payment -->
    <record id="is_view_account_payment_tree" model="ir.ui.view">
        <field name="name">is_view_account_payment_tree</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree" />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="invoice_date" optional="hide"/>
            </field>
            <field name="state" position="before">
                <field name="is_export_compta_id" optional="show"/>
            </field>
        </field>
    </record>
    <record id="is_view_account_payment_form" model="ir.ui.view">
        <field name="name">is_view_account_payment_form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <!-- v20 : move_id n'est plus dans le formulaire -->
            <field name="memo" position="after">
                <field name="is_export_compta_id"/>
            </field>
        </field>
    </record>


    <!-- is.motif.avoir -->
    <record id="is_motif_avoir_tree_view" model="ir.ui.view">
        <field name="name">is_motif_avoir_tree_view</field>
        <field name="model">is.motif.avoir</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="is_motif_avoir_form_view" model="ir.ui.view">
        <field name="name">is_motif_avoir_form_view</field>
        <field name="model">is.motif.avoir</field>
        <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                </group>
            </sheet>
        </form>
        </field>
    </record>
    <record id="is_motif_avoir_search_view" model="ir.ui.view">
        <field name="name">is_motif_avoir_search_view</field>
        <field name="model">is.motif.avoir</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>
    <record id="is_motif_avoir_action" model="ir.actions.act_window" >
        <field name="name">Motif avoir</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">is.motif.avoir</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem 
        id="is_motif_avoir_menu" 
        name="Motif avoir" 
        parent="account.account_invoicing_menu" 
        sequence="30"
        action="is_motif_avoir_action"
    />



    

</odoo>
